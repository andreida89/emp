		"bcryptjs": "^2.4.3",
		"chalk": "^4.1.1",
		"cross-env": "^7.0.3",
		"crypto-random-string": "^4.0.0",
		"dotenv": "^10.0.0",
		"express": "^4.17.1",
		"framer-motion": "4.1.17",
		"ioredis": "^4.27.5",
		"lodash": "^4.17.21",
		"lucide-react": "^1.14.0",
		"moment": "^2.29.1",
		"mongodb-client-encryption": "^2.3.0",
